{
  "name": "@atls/react-native-kratos",
  "version": "0.0.1",
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "main": "src/index.ts",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn library build",
    "prepack": "yarn run build",
    "postpack": "rm -rf dist"
  },
  "dependencies": {
    "@atls/react-kratos": "0.1.0"
  },
  "devDependencies": {
    "@ory/kratos-client-fetch": "26.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "expo": "56.0.9",
    "expo-secure-store": "56.0.4",
    "global-jsdom": "25.0.0",
    "jsdom": "25.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3"
  },
  "peerDependencies": {
    "@ory/kratos-client-fetch": "^26.2.0",
    "expo": "^56.0.0",
    "expo-secure-store": "^56.0.4",
    "react": "^19.2.3",
    "react-native": "^0.85.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "dist/index.js",
    "typings": "dist/index.d.ts"
  },
  "typecheckSkipLibCheck": true
}
